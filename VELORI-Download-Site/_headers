/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'

/files/*.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="VELORI-Android.apk"
  Cache-Control: public, max-age=3600

/media/*
  Cache-Control: public, max-age=86400
